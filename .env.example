# =============================================================================
# FCAI BSU Education Platform - Environment Configuration
# =============================================================================
# Copy this file to `.env` to customize your local development settings:
#   cp .env.example .env
# =============================================================================

# 1. Backend REST API Base URL
# Point this to your backend server (e.g. FastAPI, Node.js/Express, Spring Boot, ASP.NET, Django)
VITE_API_BASE_URL=http://localhost:8000/api/v1

# 2. API Mode
# Set to "false" to send REAL HTTP requests to VITE_API_BASE_URL.
# Set to "true" to use simulated in-memory mock data (great for frontend development & demos).
VITE_USE_MOCK_API=false

# 3. Application Metadata
VITE_APP_NAME="FCAI BSU Education Platform"
VITE_APP_ENV=development

# 4. Developer Tools & Debugging
# Set to "true" to log every HTTP request, URL, headers, and payload to the browser console
VITE_ENABLE_API_LOGGING=true

# 5. Network Request Timeout (in milliseconds)
VITE_API_TIMEOUT_MS=15000
