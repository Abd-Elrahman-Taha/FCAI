# =============================================================================
# FCAI BSU Education Platform — Environment Configuration Example
# =============================================================================
# Copy this file to `.env` to customize your local environment:
#   cp .env.example .env
# =============================================================================

# Backend REST API Base URL (must include the /api prefix)
# Local development backend:
VITE_API_BASE_URL=https://localhost:7124/api
# Deployed Swagger backend alternative:
# VITE_API_BASE_URL=https://fcaibsu.runasp.net/api

# Application Metadata
VITE_APP_NAME="FCAI BSU Education Platform"
VITE_APP_ENV=development

# Safe HTTP method/URL/status logging (never logs tokens, passwords, or PII)
VITE_ENABLE_API_LOGGING=false

# Network Request Timeout (in milliseconds)
VITE_API_TIMEOUT_MS=15000
