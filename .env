# =============================================================================
# FCAI BSU Education Platform — Environment Configuration (.env)
# =============================================================================

# Deployed Backend REST API Base URL (Swagger: https://fcaibsu.runasp.net/swagger/)
# For local backend development, switch to: https://localhost:7124/api
VITE_API_BASE_URL=https://fcaibsu.runasp.net/api

# Application Metadata
VITE_APP_NAME="FCAI BSU Education Platform"
VITE_APP_ENV=development

# Safe HTTP method/URL/status logging (never logs tokens, passwords, or PII)
VITE_ENABLE_API_LOGGING=false

# Network Request Timeout (in milliseconds)
VITE_API_TIMEOUT_MS=15000
